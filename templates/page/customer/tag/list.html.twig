{# The tags of customers (App\Customer\Controller\TagListController): static, with one dummy row. #}
{% extends 'page/customer/_list_layout.html.twig' %}

{% set texts = 'customer.tag_list' %}

{% block content %}
    <section class="data-card" aria-label="{{ 'customer.tag_list.title'|trans }}">
        <div class="data-card__scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">{{ 'customer.field.tag_name'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Stammkunde</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}

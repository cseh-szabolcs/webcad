{#
 # The customers (App\Customer\Controller\CustomerListController): static, with two dummy rows,
 # the first one selected and shown in the detail panel beside the list. Search, filter and
 # sorting are plain form fields, the row button shows only the three dots: no JavaScript yet.
 # Editing and creating plans do not exist yet, so their links have the href #.
 #}
{% extends 'page/customer/_list_layout.html.twig' %}

{% set texts = 'customer.list' %}

{% block content %}
    <div class="split">
        <twig:TableList
            label="{{ 'customer.list.title'|trans }}"
            count="{{ 'customer.list.count_other'|trans({'%count%': 2}) }}"
            dataSource="{{ path('customer_company_list_data') }}"
            contextId="customer-actions"
            bindController="page--customer--list">

            <twig:block name="filter">
                <twig:Form:SearchInput
                    label="{{ 'customer.list.search_label'|trans }}"
                    placeholder="{{ 'customer.list.search_placeholder'|trans }}"
                />
                <twig:Form:Select
                    icon="filter"
                    label="{{ 'customer.list.filter_label'|trans }}"
                    options="{{ [
                        { value: '', label: 'customer.list.all_tags'|trans },
                        { value: 'uuid-01', label: 'Öffentlich' },
                        { value: 'uuid-02', label: 'Stammkunde' },
                    ] }}"
                />
                <twig:Form:Select
                    icon="sort"
                    label="{{ 'customer.list.sort_label'|trans }}"
                    testHandler="sortModel"
                    options="{{ [
                        { value: 'updated:desc', label: 'customer.list.sort.updated'|trans },
                        { value: 'created:desc', label: 'customer.list.sort.created'|trans },
                        { value: 'name:asc', label: 'customer.list.sort.name_asc'|trans },
                        { value: 'name:desc', label: 'customer.list.sort.name_desc'|trans },
                    ] }}"
                />
            </twig:block>
            <twig:block name="head">
                <twig:TableList:Head label="{{ 'customer.field.name'|trans }}" />
                <twig:TableList:Head label="{{ 'customer.field.contact'|trans }}" />
                <twig:TableList:Head label="{{ 'customer.field.tags'|trans }}" />
                <twig:TableList:Head label="{{ 'customer.field.updated'|trans }}" />
                <twig:TableList:Head class="data-table__cell--action">
                    <span class="visually-hidden">{{ 'customer.list.actions'|trans }}</span>
                </twig:TableList:Head>
            </twig:block>
            <twig:block name="body">
                <twig:TableList:Row :selected="true">
                    <twig:TableList:Col>
                        <twig:Identity
                            icon="building"
                            name="Stadtwerke Musterstadt"
                            subtext="{{ 'customer.list.company_contact'|trans }}"
                        />
                    </twig:TableList:Col>
                    <twig:TableList:Col>
                        <div class="meta-list">
                            <span class="meta-list__item meta-list__item--link">
                                {{ svg_icon('mail', {size:'sm'}) }} info@stadtwerke.example.com
                            </span>
                        </div>
                    </twig:TableList:Col>
                    <twig:TableList:Col>
                        <div class="pills">
                            <span class="pill tone--orange">Öffentlich</span>
                            <span class="pill tone--green">Stammkunde</span>
                        </div>
                    </twig:TableList:Col>
                    <twig:TableList:Col label="Gestern" />
                    <twig:TableList:Col :contextMenu="true">
                        <twig:ContextMenu:Trigger
                            targetId="customer-actions"
                            label="{{ 'customer.list.actions_for'|trans({'%name%': 'Mira Keller'}) }}"
                        />
                    </twig:TableList:Col>
                </twig:TableList:Row>
            </twig:block>
            <twig:block name="contextmenu">
                <twig:ContextMenu
                    id="customer-actions"
                    label="{{ 'customer.list.actions'|trans }}"
                    items="{{ [
                        {action: 'edit', label: 'customer.list.edit'|trans },
                        {action: 'delete', label: 'customer.list.delete'|trans, button: true },
                        {action: 'createPlan', label: 'customer.list.create_plan'|trans },
                    ] }}"
                />
            </twig:block>
        </twig:TableList>
    </div>

    {% include 'page/customer/list-static.html.twig' %}
{% endblock %}

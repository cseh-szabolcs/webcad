{#
 # The pages of the customer area: the heading with the create button, the tabs and the block
 # `content`. A page sets `texts` (the prefix of its translation keys).
 #
 # Static markup for now, with dummy rows and without JavaScript: loading, searching, filtering,
 # sorting, selecting and the row menu come back step by step. The create pages do not exist
 # yet, so the button has the href #.
 #}
{% extends 'app.html.twig' %}

{% block title %}{{ (texts ~ '.title')|trans }} – {{ 'layout.brand'|trans }}{% endblock %}

{% block body %}
    <div class="stack">
        <header class="page-head page-head--action page-head--large">
            <div class="page-head__text">
                <h1 class="page-head__title">{{ (texts ~ '.heading')|trans }}</h1>
                <p class="page-head__lead">{{ (texts ~ '.lead')|trans }}</p>
            </div>
            <a class="btn btn--primary page-head__action" href="#">
                <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                {{ (texts ~ '.create')|trans }}
            </a>
        </header>

        <twig:SegmentTabs label="{{ 'customer.nav.label'|trans }}">
            {% for tab in [
                {key: 'customer', label: 'customers'},
                {key: 'customer_company', label: 'companies'},
                {key: 'customer_tag', label: 'tags'},
            ] %}
                <twig:SegmentTabs:Tab
                    key="{{ tab.key }}"
                    href="{{ path(tab.key ~ '_list_index') }}"
                    dataSource="{{ path(tab.key ~ '_list_count') }}"
                    label="{{ ('customer.nav.' ~ tab.label)|trans }}"
                    active="{{ app.current_route == tab.key ~ '_list_index' }}"
                />
            {% endfor %}
        </twig:SegmentTabs>

        {% block content %}{% endblock %}
    </div>
{% endblock %}

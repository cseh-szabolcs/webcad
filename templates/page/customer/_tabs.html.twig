{#
 # The tabs of the customer area: links to its lists, each with the number of its items. The
 # numbers are dummies matching the dummy rows of the lists.
 #}

{% set tabs = [
    {key: 'customers', label: 'customer.nav.customers', route: 'customer_list_index', data_src: 'customer_list_data'},
    {key: 'companies', label: 'customer.nav.companies', route: 'customer_company_list_index', data_src: 'customer_company_list_data'},
    {key: 'tags', label: 'customer.nav.tags', route: 'customer_tag_list_index', data_src: 'customer_tag_list_data'},
] %}

<twig:SegmentTabs label="{{ 'customer.nav.label'|trans }}">
    {% for tab in outerScope.tabs %}
        <twig:SegmentTabs:Tab
            key="{{ tab.key }}"
            href="{{ path(tab.route) }}"
            dataSource="{{ path(tab.data_src, {page: 1, pageSize: 1}) }}"
            label="{{ tab.label|trans }}"
            :active="app.current_route == tab.route"
        />
    {% endfor %}
</twig:SegmentTabs>

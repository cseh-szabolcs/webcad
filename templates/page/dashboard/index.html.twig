{# Start page for logged-in users; a placeholder until projects are listed here. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.title'|trans }} – {{ 'layout.brand'|trans }}{% endblock %}

{% block body_class %}page-auth page-dashboard{% endblock %}

{% block body %}
    <div class="auth-zone grid-zone">
        <div class="auth container">
            <section class="auth__panel">
                <div class="card">
                    <header class="card__header">
                        <p class="eyebrow">{{ 'dashboard.title'|trans }}</p>
                        <h1 class="card__title">{{ 'dashboard.heading'|trans }}</h1>
                        <p class="card__lead">{{ 'dashboard.lead'|trans({'%email%': app.user.userIdentifier, '%tenant%': tenant.name}) }}</p>
                    </header>

                    <a class="btn btn--ghost btn--lg btn--block" href="{{ logout_path() }}">{{ 'layout.nav.logout'|trans }}</a>
                </div>
            </section>

            <div class="auth__visual">
                {{ include('layout/_drawing.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}

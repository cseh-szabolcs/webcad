<twig:Form:Select
    icon="sort"
    label="{{ 'customer.list.sort_label'|trans }}"
    options="{{ [
        { value: 'updated:desc', label: 'customer.list.sort.updated'|trans },
        { value: 'created:desc', label: 'customer.list.sort.created'|trans },
        { value: 'name:asc', label: 'customer.list.sort.name_asc'|trans },
        { value: 'name:desc', label: 'customer.list.sort.name_desc'|trans },
    ] }}"
/>

{% set tabs = [
    {key: 'customers', label: 'customer.nav.customers', route: 'customer_list_index', data_route: 'customer_list_data'},
    {key: 'companies', label: 'customer.nav.companies', route: 'customer_company_list_index', data_route: 'customer_company_list_data'},
    {key: 'tags', label: 'customer.nav.tags', route: 'customer_tag_list_index', data_route: 'customer_tag_list_data'},
] %}

<twig:SegmentTabs label="{{ 'customer.nav.label'|trans }}">
    {% for tab in outerScope.tabs %}
        <twig:SegmentTabs:Tab
            key="{{ tab.key }}"
            href="{{ path(tab.route) }}"
            dataSource="{{ path(tab.data_route, {page: 1, pageSize: 1}) }}"
            label="{{ tab.label|trans }}"
            :active="app.current_route == tab.route"
        />
    {% endfor %}
</twig:SegmentTabs>


<td class="customer-row__actions">
    <twig:ContextMenu
        label="Aktionen"
        targetId="customer-context-menu"
        bindItem="item"
        bindItemLabelFn="getContextMenuLabel"
    />
</td>

<!-- block: asside //-->
<twig:ContextMenu:Layer
    id="customer-context-menu"
    label="{{ 'customer.list.actions'|trans }}"
    items="{{ [
        {action: 'edit', label: 'customer.list.edit'|trans },
        {action: 'delete', label: 'customer.list.delete'|trans, button: true },
        {action: 'createPlan', label: 'customer.list.create_plan'|trans },
    ] }}"
/>

{# Title block (Schriftfeld) of the decorative drawing sheet #}
<dl class="title-block" aria-hidden="true">
    <div><dt>{{ 'plan.title_block.project'|trans }}</dt><dd>{{ 'plan.title_block.project_value'|trans }}</dd></div>
    <div><dt>{{ 'plan.title_block.sheet'|trans }}</dt><dd>{{ 'plan.title_block.sheet_value'|trans }}</dd></div>
    <div><dt>{{ 'plan.title_block.scale'|trans }}</dt><dd>1:100</dd></div>
    <div><dt>{{ 'plan.title_block.revision'|trans }}</dt><dd>A</dd></div>
</dl>

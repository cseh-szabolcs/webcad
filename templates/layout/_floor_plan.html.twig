{# Decorative floor plan (12,00 × 8,00 m at 40 px/m); the strokes are drawn in by CSS, see .plan in app.css. #}
<svg class="plan" viewBox="0 0 600 400" aria-hidden="true" focusable="false">
    {# Dimension chains #}
    <g class="plan__dim">
        <path pathLength="1" d="M60 30H540M60 22v30M340 22v30M540 22v30M56 34l8-8M336 34l8-8M536 34l8-8"/>
        <path pathLength="1" d="M30 60V380M22 60h30M22 260h30M22 380h30M26 64l8-8M26 264l8-8M26 384l8-8"/>
        <text x="200" y="24">7,00</text>
        <text x="440" y="24">5,00</text>
        <text x="24" y="160" transform="rotate(-90 24 160)">5,00</text>
        <text x="24" y="320" transform="rotate(-90 24 320)">3,00</text>
    </g>

    {# Room fills by use #}
    <g class="plan__rooms">
        <rect class="plan__room plan__room--living" x="60" y="60" width="280" height="200"/>
        <rect class="plan__room plan__room--kitchen" x="60" y="260" width="280" height="120"/>
        <rect class="plan__room plan__room--sleeping" x="340" y="60" width="200" height="180"/>
        <rect class="plan__room plan__room--bath" x="340" y="240" width="200" height="140"/>
    </g>

    {# Walls: outer wall with the entrance gap, then the inner walls #}
    <path class="plan__wall plan__wall--outer" pathLength="1" d="M300 380H540V60H60V380H260"/>
    <path class="plan__wall" pathLength="1" d="M340 60V140M340 176V380M60 260H160M240 260H340M340 240H360M396 240H540"/>

    {# Windows #}
    <g class="plan__window">
        <rect x="120" y="55" width="100" height="10"/><path d="M120 60H220"/>
        <rect x="400" y="55" width="80" height="10"/><path d="M400 60H480"/>
        <rect x="55" y="120" width="10" height="90"/><path d="M60 120V210"/>
        <rect x="535" y="280" width="10" height="70"/><path d="M540 280V350"/>
    </g>

    {# Doors: leaf and swing #}
    <path class="plan__door" pathLength="1" d="M340 140h36M376 140A36 36 0 0 1 340 176"/>
    <path class="plan__door" pathLength="1" d="M360 240v36M360 276A36 36 0 0 0 396 240"/>
    <path class="plan__door" pathLength="1" d="M300 380V340M300 340A40 40 0 0 0 260 380"/>

    {# Furniture #}
    <g class="plan__furniture">
        <circle pathLength="1" cx="190" cy="160" r="26"/>
        <rect pathLength="1" x="66" y="268" width="26" height="106"/>
        <circle pathLength="1" cx="79" cy="300" r="7"/>
        <rect pathLength="1" x="420" y="70" width="104" height="126" rx="3"/>
        <path pathLength="1" d="M428 78h40v22h-40zM476 78h40v22h-40z"/>
        <rect pathLength="1" x="484" y="250" width="46" height="118" rx="10"/>
    </g>

    {# Room labels #}
    <g class="plan__label">
        <text x="200" y="222">{{ 'plan.living'|trans }}</text>
        <text class="plan__area" x="200" y="240">35,0 m²</text>
        <text x="216" y="318">{{ 'plan.kitchen'|trans }}</text>
        <text class="plan__area" x="216" y="336">21,0 m²</text>
        <text x="440" y="214">{{ 'plan.bedroom'|trans }}</text>
        <text class="plan__area" x="440" y="232">22,5 m²</text>
        <text x="420" y="318">{{ 'plan.bath'|trans }}</text>
        <text class="plan__area" x="420" y="336">17,5 m²</text>
    </g>

    {# Cursor snapping to a wall corner, like the editor's object snap #}
    <g class="plan__cursor">
        <path class="plan__crosshair" d="M290 240H390M340 190V290"/>
        <rect class="plan__pickbox" x="335" y="235" width="10" height="10"/>
        <rect class="plan__snap" x="332" y="232" width="16" height="16"/>
        <g class="plan__tooltip">
            <rect x="354" y="250" width="84" height="22" rx="2"/>
            <text x="362" y="265">{{ 'plan.snap_endpoint'|trans }}</text>
        </g>
    </g>
</svg>

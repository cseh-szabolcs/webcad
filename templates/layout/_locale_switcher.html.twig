{# Links the current page in every enabled locale; pages without a route (e.g. errors) fall back to the home page. #}
{% set current = app.request.locale %}
<details class="locale-switcher">
    <summary class="locale-switcher__toggle" aria-label="{{ 'layout.locale.label'|trans }}: {{ current|locale_name(current)|capitalize }}">
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.5"/><path d="M2.5 10h15M10 2.5c2.2 2.1 3.3 4.6 3.3 7.5s-1.1 5.4-3.3 7.5c-2.2-2.1-3.3-4.6-3.3-7.5s1.1-5.4 3.3-7.5z"/></svg>
        <span>{{ current|upper }}</span>
    </summary>
    <ul class="locale-switcher__menu">
        {% for locale in app.enabled_locales %}
            {% set route = app.current_route ?? 'app_index' %}
            {% set params = app.current_route ? app.current_route_parameters : {} %}
            <li>
                <a href="{{ path(route, params|merge({_locale: locale})) }}" hreflang="{{ locale }}" lang="{{ locale }}"
                   {%- if locale == current %} aria-current="true"{% endif %}>
                    <span class="locale-switcher__code">{{ locale|upper }}</span>
                    {{ locale|locale_name(locale)|capitalize }}
                </a>
            </li>
        {% endfor %}
    </ul>
</details>

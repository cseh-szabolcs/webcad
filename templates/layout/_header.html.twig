<header class="site-header">
    <div class="container site-header__inner">
        <a class="brand" href="{{ path(is_granted('IS_AUTHENTICATED') ? 'app_dashboard' : 'app_index') }}">
            <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
                <rect x="7.5" y="7.5" width="17" height="17"/>
                <path d="M4 7.5h7M21 7.5h7M4 24.5h7M21 24.5h7" stroke-width="7"/>
            </svg>
            <span class="brand__name">{{ 'layout.brand'|trans }}</span>
        </a>

        <nav class="site-nav" aria-label="{{ 'layout.nav.label'|trans }}">
            {{ include('layout/_locale_switcher.html.twig') }}
            {% if is_granted('IS_AUTHENTICATED') %}
                <a class="btn btn--ghost" href="{{ path('app_dashboard') }}"
                   {%- if app.current_route == 'app_dashboard' %} aria-current="page"{% endif %}>{{ 'layout.nav.dashboard'|trans }}</a>
                <a class="btn btn--primary" href="{{ logout_path() }}">{{ 'layout.nav.logout'|trans }}</a>
            {% else %}
                <a class="btn btn--ghost" href="{{ path('user_auth_login') }}"
                   {%- if app.current_route == 'user_auth_login' %} aria-current="page"{% endif %}>{{ 'layout.nav.login'|trans }}</a>
                <a class="btn btn--primary" href="{{ path('user_auth_register') }}"
                   {%- if app.current_route == 'user_auth_register' %} aria-current="page"{% endif %}>{{ 'layout.nav.register'|trans }}</a>
            {% endif %}
        </nav>
    </div>
</header>

<div
    id="{{ id }}"
    class="customer-menu"
    popover
    {% if label %} aria-label="{{ label }}"{% endif %}
    x-on:keydown.escape.window="onEscape()"
    x-on:scroll.window.capture="closeMenu()"
    {{ stimulus_controller('components--menu--context-menu', { state: {
        id: id,
    }}) }}
>
    {% for item in items %}
        {% if item.button is defined and item.button %}
            <button type="button" x-on:click.prevent.stop="handleAction('{{ item.action }}')" class="customer-menu__item customer-menu__item--danger">
                {{ item.label }}
            </button>
        {% else %}
            <a href="#" x-on:click.prevent.stop="handleAction('{{ item.action }}')" class="customer-menu__item">
                {{ item.label }}
            </a>
        {% endif %}
    {% endfor %}
</div>

{% set onChangeHandler = bindHandler ? bindHandler ~ '($event.target.value, $event)' : null %}
<label class="field-box">
    {% if icon %}
        {{ svg_icon(icon) }}
    {% endif %}
    <span class="visually-hidden">{{ label }}</span>
    <select
        {% if bindModel %} x-model="{{ bindModel }}"{% endif %}
        {% if bindHandler %} x-on:change="{{ onChangeHandler }}"{% endif %}
    >
        {% block content %}
            {% for option in options %}
                <option value="{{ option['value'] }}"{% if value === option['value'] %} selected{% endif %}>{{ option['label'] }}</option>
            {% endfor %}
        {% endblock %}
    </select>
</label>

<label class="field-box">
    {% if icon %}
        {{ svg_icon(icon) }}
    {% endif %}
    <span class="visually-hidden">{{ label }}</span>
    <select {% if bindModel %} x-model="{{ bindModel }}"{% endif %}>
        {% for option in options %}
            <option value="{{ option['value'] }}">{{ option['label'] }}</option>
        {% endfor %}
    </select>
</label>

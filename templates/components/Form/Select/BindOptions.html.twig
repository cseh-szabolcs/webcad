{% set loop = 'option in ' ~ data %}
{% set bindValue = 'option.' ~ identifier %}
{% set bindLabel = 'option.' ~ label %}
{% set bindSelected = value ? (bindValue ~ "=='" ~ value ~ "'") : null %}

<template x-for="{{ loop }}" x-bind:key="{{ bindValue }}">
    <option
        x-bind:value="{{ bindValue }}"
        x-text="{{ bindLabel }}"
        {% if bindSelected %} x-bind:selected="{{ bindSelected }}"{% endif %}>
    </option>
</template>

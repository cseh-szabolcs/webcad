<div
    id="{{ id }}"
    class="context-menu"
    popover
    {% if label %} aria-label="{{ label }}"{% endif %}
    x-on:keydown.escape.window="closeMenu()"
    x-on:scroll.window.capture="closeMenu()"
    {{ stimulus_controller('components--context-menu', {state: {
        id: id,
    }}) }}>

    {% for item in items %}
        {% if item.button is defined and item.button %}
            <button type="button" x-on:click.prevent.stop="handleAction('{{ item.action }}')" class="context-menu__item context-menu__item--danger">
                {{ item.label }}
            </button>
        {% else %}
            <a href="#" x-on:click.prevent.stop="handleAction('{{ item.action }}')" class="context-menu__item">
                {{ item.label }}
            </a>
        {% endif %}
    {% endfor %}
</div>

# Origin of the backend (API and /socket.io) when the page does not name one with data-backend-host
# (the Symfony page does, from EDITOR_BACKEND_HOST). Empty: the editor's own origin, in dev the Vite
# proxy. Override per machine in .env.local, per mode in .env.production.
VITE_BACKEND_HOST=

# Extra wait in ms before the loaded plan replaces the loading skeleton (to look at it), when the
# page does not name one with data-loading-delay (the Symfony page does, from EDITOR_LOADING_DELAY_MS).
VITE_LOADING_DELAY_MS=0
